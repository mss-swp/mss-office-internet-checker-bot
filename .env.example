# Telegram Bot Configuration Template
# Target IP to monitor (e.g., office public IP or gateway)
IP="your_target_ip_here"

# Telegram Bot Token from @BotFather
TOKEN="your_telegram_bot_token_here"

# Telegram Chat/Group ID from @getidsbot (include '-' for groups, e.g., -100xxxxxxxxxx)
CHAT_ID="your_telegram_chat_id_here"

# Status lock file path
STATUS_FILE="/tmp/office_status.txt"
